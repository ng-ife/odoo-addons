<odoo>
    <record id="view_repo_list" model="ir.ui.view">
        <field name="name">ife.repo.list</field>
        <field name="model">ife.repo</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="github_url" />
                <field name="type" />
            </list>
        </field>
    </record>
    <record id="view_repo_form" model="ir.ui.view">
        <field name="name">ife.repo.form</field>
        <field name="model">ife.repo</field>
        <field name="arch" type="xml">
            <form>
                <field name="is_cloned" invisible="1" />
                <header>
                    <button
                        name="action_clone_repo"
                        type="object"
                        string="Clone Repo"
                        class="btn-primary"
                        invisible="is_cloned == True"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="path" />
                        <field name="github_url" />
                        <field name="type" />
                    </group>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_branches"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-anchor"
                            invisible="branch_count == 0"
                        >
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="branch_count" />
                                </span>
                                <span class="o_stat_text">Branches</span>
                            </div>
                        </button>
                    </div>
                    <notebook>
                        <page string="Branches">
                            <field name="branch_ids">
                                <list>
                                    <field name="name" />
                                    <field name="is_cloned" />
                                    <field name="is_dirty" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ife_repo_action" model="ir.actions.act_window">
        <field name="name">Repositories</field>
        <field name="res_model">ife.repo</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
