<odoo>
    <record id="view_module_list" model="ir.ui.view">
        <field name="name">ife.module.list</field>
        <field name="model">ife.module</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="folder_id"/>
            </list>
        </field>
    </record>
    <record id="view_module_form" model="ir.ui.view">
        <field name="name">ife.module.form</field>
        <field name="model">ife.module</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="folder_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ife_module_action" model="ir.actions.act_window">
        <field name="name">Modules</field>
        <field name="res_model">ife.module</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
