<odoo>
    <record id="view_foldername_list" model="ir.ui.view">
        <field name="name">ife.foldername.list</field>
        <field name="model">ife.foldername</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="github_url" />
            </list>
        </field>
    </record>
    <record id="view_foldername_form" model="ir.ui.view">
        <field name="name">ife.foldername.form</field>
        <field name="model">ife.foldername</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="github_url" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ife_foldername_action" model="ir.actions.act_window">
        <field name="name">Folders</field>
        <field name="res_model">ife.foldername</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
