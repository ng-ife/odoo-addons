<odoo>
    <record id="view_environment_list" model="ir.ui.view">
        <field name="name">ife.environment.list</field>
        <field name="model">ife.environment</field>
        <field name="arch" type="xml">
            <list default_group_by="customer_project_id">
                <field name="customer_project_id"/>
                <field name="name"/>
                <field name="branch_id"/>
            </list>
        </field>
    </record>
    <record id="view_environment_form" model="ir.ui.view">
        <field name="name">ife.environment.form</field>
        <field name="model">ife.environment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="export_config_yaml" string="Export Config YAML" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="branch_id"/>
                        <field name="customer_project_id"/>
                    </group>
                    <notebook>
                        <page string="Modules">
                            <field name="module_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="folder_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ife_environment_action" model="ir.actions.act_window">
        <field name="name">Environments</field>
        <field name="res_model">ife.environment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
