<odoo>
    <record id="view_environment_module_list" model="ir.ui.view">
        <field name="name">ife.environment.module.list</field>
        <field name="model">ife.environment.module</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="folder_id" />
                <field name="repo_module_id" />
                <field name="environment_id" />
            </list>
        </field>
    </record>
    <record id="view_environment_module_form" model="ir.ui.view">
        <field name="name">ife.environment.module.form</field>
        <field name="model">ife.environment.module</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="folder_id" />
                        <field name="repo_module_id" />
                        <field name="environment_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ife_environment_module_action" model="ir.actions.act_window">
        <field name="name">Environment Modules</field>
        <field name="res_model">ife.environment.module</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
