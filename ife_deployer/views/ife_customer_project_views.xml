<odoo>
    <record id="view_customer_project_list" model="ir.ui.view">
        <field name="model">ife.customer.project</field>
        <field name="name">ife.customer.project.list</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="github_url"/>
            </list>
        </field>
    </record>
    <record id="view_customer_project_form" model="ir.ui.view">
        <field name="name">ife.customer.project.form</field>
        <field name="model">ife.customer.project</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="github_url"/>
                        <field name="environment_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ife_customer_project_action" model="ir.actions.act_window">
        <field name="name">Customer Projects</field>
        <field name="res_model">ife.customer.project</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
