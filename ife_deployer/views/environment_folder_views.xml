<odoo>
    <record id="view_environment_folder_list" model="ir.ui.view">
        <field name="name">ife.environment.folder.list</field>
        <field name="model">ife.environment.folder</field>
        <field name="arch" type="xml">
            <list default_group_by="customer_project_id">
                <field name="customer_project_id"/>
                <field name="environment_id"/>
                <field name="name"/>
                <field name="repo_id"/>
                <field name="ref"/>
            </list>
        </field>
    </record>
    <record id="view_environment_folder_form" model="ir.ui.view">
        <field name="name">ife.environment.folder.form</field>
        <field name="model">ife.environment.folder</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="environment_id"/>
                        <field name="name"/>
                        <field name="repo_id"/>
                        <field name="ref"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ife_environment_folder_action" model="ir.actions.act_window">
        <field name="name">Folders</field>
        <field name="res_model">ife.environment.folder</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
