<odoo>
    <template
        id="report_saleorder_inherit"
        inherit_id="sale.report_saleorder_document"
        priority="15"
    >
        <!-- Hide Country if sender and receiver country are the same -->
        <xpath expr="//t[@t-set='forced_vat']" position="after">
            <t
                t-set="report_hide_country"
                t-if="doc and 'report_hide_country' in doc"
                t-value="doc.report_hide_country"
            />
        </xpath>
        <xpath expr="//div[@t-field='doc.partner_id']" position="attributes">
            <attribute name="t-options">
                {"widget": "contact", "fields": ["address", "name"], "no_marker": True, "no_country": report_hide_country}
            </attribute>
        </xpath>
        <xpath expr="//div[@t-field='doc.partner_invoice_id']" position="attributes">
            <attribute name="t-options">
                {"widget": "contact", "fields": ["address", "name"], "no_marker": True, "phone_icons": True, "no_country": report_hide_country}
            </attribute>
        </xpath>
        <xpath expr="//div[@t-field='doc.partner_shipping_id']" position="attributes">
            <attribute name="t-options">
                {"widget": "contact", "fields": ["address", "name"], "no_marker": True, "phone_icons": True, "no_country": report_hide_country}
            </attribute>
        </xpath>
        <xpath expr="//th[1]" position="before">
            <th name="th_position_number" class="text-start">
                <span>Pos</span>
            </th>
        </xpath>
        <xpath expr="//t[@t-set='current_subtotal']" position="after">
            <t t-set="position_number" t-value="1" />
        </xpath>
        <xpath expr="//td[@name='td_name']" position="before">
            <td name="td_position">
                <span t-out="str(position_number).zfill(2)">01</span>
            </td>
            <t t-set="position_number" t-value="position_number + 1" />
        </xpath>
    </template>
    <template
        id="report_saleorder_document_din5008_inherit"
        inherit_id="l10n_din5008_sale.report_saleorder_document"
    >
        <xpath expr="//tr[@t-if='doc.client_order_ref']" position="attributes">
            <attribute name="class">
                d-none
            </attribute>
        </xpath>
        <xpath expr="//address[@t-esc='delivery_partner']" position="attributes">
            <attribute name="t-options">
                {"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "no_country": report_hide_country}
            </attribute>
        </xpath>
        <xpath expr="//address[@t-esc='commercial_partner']" position="attributes">
            <attribute name="t-options">
                {"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "no_country": report_hide_country}
            </attribute>
        </xpath>
        <xpath
            expr="//t[@t-if]/td/address[@t-esc='doc.partner_shipping_id']"
            position="attributes"
        >
            <attribute name="t-options">
                {"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "no_country": report_hide_country}
            </attribute>
        </xpath>
        <xpath
            expr="//t[@t-else]/td/address[@t-esc='doc.partner_shipping_id']"
            position="attributes"
        >
            <attribute name="t-options">
                {"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "no_country": report_hide_country}
            </attribute>
        </xpath>
        <xpath expr="//address[@t-esc='doc.partner_invoice_id']" position="attributes">
            <attribute name="t-options">
                {"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "no_country": report_hide_country}
            </attribute>
        </xpath>
        <xpath expr="//t[@t-set='din5008_document_title']" position="after">
            <t t-set="din5008_document_ref">
                <t t-if="doc and doc._name == 'sale.order' and doc.client_order_ref">
                    <strong>Customer Reference:</strong>
                    <span t-field="doc.client_order_ref" />
                </t>
            </t>
        </xpath>
    </template>
    <template
        id="external_layout_din5008_saleorder"
        inherit_id="l10n_din5008_sale.external_layout_din5008_saleorder"
    >
        <xpath
            expr="//address[@t-field='doc.partner_invoice_id']"
            position="attributes"
        >
            <attribute name="t-options">
                {"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "no_country": report_hide_country}
            </attribute>
        </xpath>
        <xpath
            expr="//address[@t-field='doc.partner_id.commercial_partner_id']"
            position="attributes"
        >
            <attribute name="t-options">
                {"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "no_country": report_hide_country}
            </attribute>
        </xpath>
    </template>
</odoo>
