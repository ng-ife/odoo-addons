<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_invoice_document"
        inherit_id="account.report_invoice_document"
        priority="15"
    >
        <!-- Hide Country if sender and reciever country are the same -->
        <xpath expr="//t[@t-set='forced_vat']" position="after">
            <t
                t-set="report_hide_country"
                t-if="o and 'report_hide_country' in o"
                t-value="o.report_hide_country"
            />
        </xpath>
        <xpath expr="//div[@t-field='o.partner_shipping_id']" position="attributes">
            <attribute
                name="t-options"
            >{"widget": "contact", "fields": ["address", "name"], "no_marker": True, "no_country": report_hide_country}</attribute>
        </xpath>
        <xpath
            expr="//div[@name='address_not_same_as_shipping']//address[@t-field='o.partner_id']"
            position="attributes"
        >
            <attribute
                name="t-options"
            >{"widget": "contact", "fields": ["address", "name"], "no_marker": True, "no_country": report_hide_country}</attribute>
        </xpath>
        <xpath
            expr="//div[@name='address_same_as_shipping']//address[@t-field='o.partner_id']"
            position="attributes"
        >
            <attribute
                name="t-options"
            >{"widget": "contact", "fields": ["address", "name"], "no_marker": True, "no_country": report_hide_country}</attribute>
        </xpath>
        <xpath
            expr="//div[@name='no_shipping']//address[@t-field='o.partner_id']"
            position="attributes"
        >
            <attribute
                name="t-options"
            >{"widget": "contact", "fields": ["address", "name"], "no_marker": True, "no_country": report_hide_country}</attribute>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_position_number" class="text-start">
                <span>Pos</span>
            </th>
        </xpath>
        <xpath expr="//t[@t-set='lines']" position="after">
            <t t-set="position_number" t-value="1" />
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']" position="before">
            <td name="position_number">
                <span t-out="str(position_number).zfill(2)">01</span>
            </td>
            <t t-set="position_number" t-value="position_number + 1" />
        </xpath>
        <!-- Add Line Break to Payment Terms -->
        <xpath expr="//div[@id='right-elements']" position="attributes">
            <attribute name="style">
                width: 100%;
            </attribute>
        </xpath>
        <xpath expr="//div[@id='total']" position="attributes">
            <attribute name="style">
                width: 37%;
                float: right;
            </attribute>
        </xpath>
        <xpath expr="//div[hasclass('mb-2')]" position="attributes">
            <attribute name="t-if">
                o.company_id.display_invoice_amount_total_words
            </attribute>
        </xpath>
    </template>
    <template
        id="report_invoice_document_din5008_inherit"
        inherit_id="l10n_din5008.report_invoice_document"
    >
        <xpath expr="//tr[@t-if='o.ref']" position="attributes">
            <attribute name="class">
                d-none
            </attribute>
        </xpath>
        <xpath expr="//t[@t-set='din5008_document_title']" position="after">
            <t t-set="din5008_document_ref">
                <t t-if="o and o._name == 'account.move' and o.ref">
                    <strong>Customer Reference:</strong>
                    <span t-field="o.ref" />
                </t>
            </t>
        </xpath>
    </template>
</odoo>
