<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_module_library_module_tree" model="ir.ui.view">
        <field name="name">module.library.module.tree</field>
        <field name="model">module.library.module</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false">
                <field name="name" />
                <field name="technical_name" />
                <field name="version" />
                <field name="author" />
                <field name="repository_id" />
                <field name="library_id" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="view_module_library_module_search" model="ir.ui.view">
        <field name="name">module.library.module.search</field>
        <field name="model">module.library.module</field>
        <field name="arch" type="xml">
            <search string="Suche Module">
                <field name="name" />
                <field name="technical_name" />
                <group expand="1" string="Gruppieren nach">
                    <filter
                        string="Bibliothek"
                        name="group_by_lib"
                        context="{'group_by':'library_id'}"
                    />
                    <filter
                        string="Repository"
                        name="group_by_repo"
                        context="{'group_by':'repository_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_module_library_module" model="ir.actions.act_window">
        <field name="name">Alle Module</field>
        <field name="res_model">module.library.module</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_by_lib': 1}</field>
    </record>
</odoo>
