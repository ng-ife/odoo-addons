<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_module_library_form" model="ir.ui.view">
        <field name="name">module.library.form</field>
        <field name="model">module.library</field>
        <field name="arch" type="xml">
            <form string="Bibliothek">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <field name="description" />
                    </group>
                    <notebook>
                        <page string="Repositories">
                            <field name="repository_ids">
                                <tree>
                                    <field name="name" />
                                    <field name="git_url" />
                                    <field name="state" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_module_library_tree" model="ir.ui.view">
        <field name="name">module.library.tree</field>
        <field name="model">module.library</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="description" />
            </tree>
        </field>
    </record>

    <record id="action_module_library" model="ir.actions.act_window">
        <field name="name">Bibliotheken</field>
        <field name="res_model">module.library</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
